# ─── Asaas (API v3) ───

# Chave de API da conta DA PLATAFORMA. Todas as cobranças são criadas com ela;
# o split é que roteia a parte do organizador para a carteira dele.
ASAAS_API_KEY=sua_api_key_aqui

# Ambiente. Produção: https://api.asaas.com/v3
# Se ausente, o padrão é o SANDBOX — um deploy mal configurado não cobra de verdade.
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# Token do webhook. Você define este valor ao cadastrar o webhook no painel do Asaas,
# e ele o devolve no header `asaas-access-token` de cada notificação.
# ATENÇÃO: é um segredo compartilhado, não uma assinatura HMAC como a do Mercado Pago.
# Quem obtiver este valor consegue forjar notificações — trate como credencial.
ASAAS_WEBHOOK_TOKEN=um_valor_longo_e_aleatorio

# Comissão da plataforma, em % do valor do ingresso. O organizador recebe o restante
# via split. 0 (ou ausente) = sem comissão, tudo para o organizador.
PLATFORM_FEE_PERCENT=10

# Raiz do frontend (sem barra final).
APP_BASE_URL=https://seu-dominio.com.br

# ─── E-mail transacional (Resend) ───

# O Google recusa personalizar os templates de e-mail deste projeto, então a
# redefinição de senha é enviada por nós. Chave em resend.com/api-keys.
# Em produção vai pelo Secret Manager: firebase functions:secrets:set RESEND_API_KEY
RESEND_API_KEY=re_sua_chave_aqui

# Remetente dos e-mails. Precisa ser um endereço verificado no Resend.
EMAIL_FROM=Atchei <nao-responda@seu-dominio.com.br>

# ─── Kill switch do Pix ───

# "false" faz criarCobrancaPix recusar cobranças novas (stand-by das vendas).
# Precisa acompanhar PIX_ENABLED em src/lib/flags.ts, que esconde a interface.
# O webhook NÃO é afetado: cobranças já geradas continuam podendo ser pagas.
PIX_ENABLED=true
