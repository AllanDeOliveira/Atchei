VITE_GOOGLE_MAPS_API_KEY=SUA_CHAVE_AQUI
# Chave do site (pública) do reCAPTCHA v3 para o App Check. Sem ela, o App Check fica desativado.
VITE_RECAPTCHA_SITE_KEY=SUA_CHAVE_AQUI
VITE_FIREBASE_API_KEY=SUA_CHAVE_AQUI
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
VITE_FIREBASE_MEASUREMENT_ID=SUA_CHAVE_AQUI
# Chave pública VAPID para notificações push (Firebase Console > Cloud Messaging > Web Push certificates).
# Sem ela, as notificações push ficam desativadas automaticamente.
VITE_FIREBASE_VAPID_KEY=SUA_CHAVE_AQUI
