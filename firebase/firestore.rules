rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para verificar autenticação básica
    function isAuthed() {
      return request.auth != null;
    }

    // Função auxiliar para verificar se o usuário é administrador.
    // Exclusivamente via Custom Claims (admin: true), definidos pela Cloud
    // Function setAdminClaim ou pelo script functions/scripts/set-admins.js.
    function isAdmin() {
      return isAuthed() && 'admin' in request.auth.token && request.auth.token.admin == true;
    }

    // 18+: birthDate 'YYYY-MM-DD' <= hoje menos 18 anos. Comparação de string ISO
    // equivale a comparação cronológica. string(100 + n)[1:3] zera à esquerda mês/dia
    // (rules não têm ternário para o padding). Nascido no dia exato do aniversário passa.
    function isAdult(birthDate) {
      return birthDate is string && birthDate.size() == 10 && birthDate <= (
        string(request.time.year() - 18) + '-' +
        string(100 + request.time.month())[1:3] + '-' +
        string(100 + request.time.day())[1:3]
      );
    }

    // Dono de um creatorId: o próprio uid. (Contas legadas com perfil de id != uid,
    // vinculadas por e-mail, deixaram de existir no reset de 13/11.)
    function isCreator(creatorId) {
      return isAuthed() && creatorId == request.auth.uid;
    }

    // Verifica se o usuário autenticado é o criador (dono) de um evento.
    function isEventOwner(eventId) {
      return isAuthed() &&
        exists(/databases/$(database)/documents/events/$(eventId)) &&
        isCreator(get(/databases/$(database)/documents/events/$(eventId)).data.creatorId);
    }

    // Verifica se um evento aceita presença gratuita. Um evento sem o campo
    // `hasPresence` (undefined, legado) é tratado como habilitado — espelha a UI,
    // que usa `hasPresence !== false`. hasPresence=false bloqueia inscrição gratuita
    // pelo cliente e é o DEFAULT de eventos novos (toggle desligado no formulário);
    // o organizador liga o toggle para permitir confirmação de presença.
    function eventAllowsPresence(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId)) &&
        get(/databases/$(database)/documents/events/$(eventId)).data.hasPresence != false;
    }

    // Teto TOTAL de participantes (maxParticipants). Sem o campo (ou null) não há
    // limite. Compara com registrationCount, mantido pelas triggers do backend —
    // em rajada simultânea pode passar 1-2 além do teto (contador é eventual),
    // ceiling aceito para a V1. O organizador/admin não passa por aqui (pode furar
    // o próprio teto conscientemente via inscrição manual).
    function eventHasCapacity(eventId) {
      let ev = get(/databases/$(database)/documents/events/$(eventId)).data;
      return !('maxParticipants' in ev) || ev.maxParticipants == null ||
        (('registrationCount' in ev) ? ev.registrationCount : 0) < ev.maxParticipants;
    }

    // Evento que vende ingresso (WhatsApp ou Pix) — alvo válido para uma
    // intenção de compra "Aguardando pagamento".
    function eventSellsTickets(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId)) &&
        get(/databases/$(database)/documents/events/$(eventId)).data.hasTickets == true;
    }

    match /profiles/{profileId} {
      // Doc PÚBLICO do perfil (id = uid): nome, tipo, descrição, foto, Instagram.
      // E-mail e data de nascimento ficam em profilesPrivate/{uid}: o perfil
      // profissional é legível e listável sem login, e o Firestore devolve o doc inteiro.
      // Conta pessoal segue legível só pelo dono e admin: o uid dela não é segredo
      // (events.creatorId é público; desafios/*.membros é legível por logado), e a
      // página do evento mostra o organizador pelo creatorName gravado no evento.
      allow get: if
        isAdmin() ||
        (isAuthed() && request.auth.uid == profileId) ||
        (resource != null && resource.data.type == 'profissional');
      allow list: if isAdmin() || resource.data.type == 'profissional';

      // O próprio usuário cria o seu, tipo 'user' ou 'profissional', no MESMO batch
      // do profilesPrivate (que é onde o 18+ e o e-mail são validados); admin cria
      // qualquer um.
      allow create: if isAuthed() && (
        (request.auth.uid == profileId
          && request.resource.data.type in ['user', 'profissional']
          && !request.resource.data.keys().hasAny(['email', 'birthDate'])
          && existsAfter(/databases/$(database)/documents/profilesPrivate/$(profileId))) ||
        isAdmin()
      );

      // O dono atualiza o seu sem mudar o tipo nem trazer de volta os campos privados.
      allow update: if isAuthed() && (
        (
          request.auth.uid == profileId &&
          request.resource.data.type == resource.data.type &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email', 'birthDate'])
        ) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // Parte privada do perfil: e-mail de login e data de nascimento. Só o dono e admin.
    // Nasce junto com o perfil (batch); 18+ validado aqui, não só na tela.
    match /profilesPrivate/{uid} {
      allow get: if isAdmin() || (isAuthed() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        isAuthed() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['email', 'birthDate']) &&
        'email' in request.auth.token &&
        request.resource.data.email.lower() == request.auth.token.email.lower() &&
        isAdult(request.resource.data.birthDate)
      );
      allow update, delete: if isAdmin();
    }

    match /events/{eventId} {
      // Eventos são públicos para visualização
      allow read: if true;
      // Criação: o creatorId precisa ser o próprio usuário (uid ou seu perfil
      // legado); admin pode criar em nome de um parceiro. Contadores nascem só pelo
      // backend (como no update). Id de evento apagado não volta: as inscrições
      // antigas apontam para ele, e quem o recriasse viraria "dono" delas
      // (deletedEvents é gravado pela function onEventDeleted).
      allow create: if !exists(/databases/$(database)/documents/deletedEvents/$(eventId)) && (
        isAdmin() || (
          isCreator(request.resource.data.creatorId) &&
          !request.resource.data.keys().hasAny(['registrationCount', 'soldByTicket'])
        )
      );
      // Somente o criador do evento ou o administrador podem editar/excluir.
      // O criador NÃO pode transferir a posse (creatorId) nem forjar contadores
      // geridos pelo backend (registrationCount e soldByTicket — escritos pelas
      // triggers/webhook via Admin SDK, que ignora estas regras). Admin irrestrito.
      allow update: if isAuthed() && (
        (
          isCreator(resource.data.creatorId) &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['creatorId', 'registrationCount', 'soldByTicket'])
        ) ||
        isAdmin()
      );
      allow delete: if isCreator(resource.data.creatorId) || isAdmin();
    }

    match /registrations/{registrationId} {
      // Uma inscrição só pode ser lida se:
      // 1. O solicitante for administrador
      // 2. O solicitante for o dono da inscrição (userId)
      // 3. O solicitante for o criador do evento associado
      allow read: if isAuthed() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/events/$(resource.data.eventId)) &&
          get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.creatorId == request.auth.uid
        )
      );
      // Criação de inscrição pelo cliente (a inscrição paga por Pix é criada pelo
      // webhook via Admin SDK, que ignora estas regras). Dois caminhos legítimos:
      //
      // A) Dono do evento ou admin: registra participantes do PRÓPRIO evento com
      //    qualquer status (cortesia, pago em dinheiro, Pix manual na portaria).
      //
      // B) PRESENÇA GRATUITA — exige conta (Termos de Uso; inscrição de visitante
      //    'guest-*' foi descontinuada — docs antigos permanecem legíveis):
      //    1. O evento precisa aceitar presença gratuita — impede forjar um ingresso
      //       "Gratuito" para um evento exclusivamente pago e passá-lo na portaria.
      //    2. paymentStatus é obrigatoriamente 'Gratuito' e sem lote — nunca 'Pago'
      //       nem ausente pelo cliente.
      //    3. A inscrição não pode nascer já validada (check-in é ação de portaria).
      //    4. Só em nome PRÓPRIO (userId == uid) — impede inscrição forjada em nome
      //       de outra pessoa.
      //    5. O id do doc é OBRIGATORIAMENTE eventId_uid — como criar sobre um doc
      //       existente é update (negado), o servidor garante no máximo UMA
      //       inscrição por pessoa por evento; um script não infla a lista do
      //       organizador nem a prova social (registrationCount).
      // C) INTENÇÃO DE COMPRA VIA WHATSAPP — o comprador logado entra na lista do
      //    vendedor como 'Aguardando pagamento'. NÃO é ingresso: a portaria recusa
      //    este status, e só o dono do evento pode promovê-lo a 'Pago (WhatsApp)'.
      //    Sem ticketTypeId (não mexe em estoque de lote), sempre em nome próprio,
      //    e com o mesmo id determinístico da regra 5 acima.
      //
      // B e C aceitam só as chaves que a tela grava: sem lote (ticketTypeId/Name,
      // que mexem em estoque e no rótulo da portaria) e sem isTeste (que as triggers
      // não contam, furando o maxParticipants).
      function selfRegKeysOk() {
        return request.resource.data.keys().hasOnly(['eventId', 'userId', 'userName',
          'userEmail', 'userPhone', 'paymentStatus', 'timestamp', 'checkedIn']);
      }
      allow create: if
        isAdmin() ||
        (
          // A) userId é o do próprio dono ou um convidado manual: em nome de outra
          //    conta, a inscrição apareceria no perfil dela e dispararia push com o
          //    título escolhido pelo dono. Id sem '_' (addDoc): impede ocupar o id
          //    determinístico eventId_uid de outra pessoa em outro evento.
          isEventOwner(request.resource.data.eventId) &&
          !registrationId.matches('.*_.*') &&
          request.resource.data.userId is string &&
          (request.resource.data.userId == request.auth.uid ||
           request.resource.data.userId.matches('guest-manual-[0-9]+'))
        ) ||
        (
          selfRegKeysOk() &&
          eventAllowsPresence(request.resource.data.eventId) &&
          eventHasCapacity(request.resource.data.eventId) &&
          // Status explícito: sem ele, a portaria tratava o doc como ingresso
          // (QR = id previsível) e o ticketTypeId inflava soldByTicket.
          request.resource.data.paymentStatus == 'Gratuito' &&
          (
            !('checkedIn' in request.resource.data) ||
            request.resource.data.checkedIn == false
          ) &&
          isAuthed() && request.resource.data.userId == request.auth.uid &&
          registrationId == request.resource.data.eventId + '_' + request.auth.uid
        ) ||
        (
          selfRegKeysOk() &&
          eventSellsTickets(request.resource.data.eventId) &&
          eventHasCapacity(request.resource.data.eventId) &&
          request.resource.data.paymentStatus == 'Aguardando pagamento' &&
          (
            !('checkedIn' in request.resource.data) ||
            request.resource.data.checkedIn == false
          ) &&
          isAuthed() && request.resource.data.userId == request.auth.uid &&
          registrationId == request.resource.data.eventId + '_' + request.auth.uid
        );

      // Atualização: admin (irrestrita) OU o dono do evento, mas SÓ para registrar
      // o check-in na portaria — restrito aos campos de validação e sem permitir
      // reverter um check-in (impede reabrir reentrada / apagar a trilha de auditoria).
      // ... ou o dono do evento confirmando o pagamento de uma intenção WhatsApp —
      // só a transição 'Aguardando pagamento' → 'Pago (WhatsApp)', gravando junto o
      // ticketSecret aleatório que vira o QR: o id (eventId_uid) é derivável de dados
      // públicos e deixaria um terceiro passar na portaria antes do comprador.
      allow update: if isAdmin() || (
        isEventOwner(resource.data.eventId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['checkedIn', 'checkedInAt', 'checkedInBy']) &&
        request.resource.data.checkedIn == true
      ) || (
        isEventOwner(resource.data.eventId) &&
        resource.data.paymentStatus == 'Aguardando pagamento' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['paymentStatus', 'ticketSecret']) &&
        request.resource.data.paymentStatus == 'Pago (WhatsApp)' &&
        request.resource.data.ticketSecret is string &&
        request.resource.data.ticketSecret.size() >= 32
      );

      // Deletar: admin, ou o PRÓPRIO usuário cancelando uma presença gratuita ou
      // uma intenção WhatsApp ainda não confirmada (reversíveis). Nunca após
      // check-in e nunca uma inscrição paga (estorno é fluxo do backend).
      // O dono do evento também remove intenções 'Aguardando pagamento' da sua
      // lista (comprador que desistiu) — mas nunca um ingresso já pago.
      allow delete: if isAdmin() || (
        isAuthed() &&
        resource.data.userId == request.auth.uid &&
        (
          !('paymentStatus' in resource.data) ||
          resource.data.paymentStatus == 'Gratuito' ||
          resource.data.paymentStatus == null ||
          resource.data.paymentStatus == 'Aguardando pagamento'
        ) &&
        resource.data.checkedIn != true
      ) || (
        isEventOwner(resource.data.eventId) &&
        resource.data.paymentStatus == 'Aguardando pagamento'
      );
    }

    // Tokens de push (FCM): cada dispositivo registra seu próprio token vinculado ao seu UID.
    // A leitura é feita exclusivamente pelo backend (Admin SDK) ao enviar notificações.
    match /fcmTokens/{token} {
      allow read: if false;
      // O usuário só pode criar/atualizar um token apontando para o seu próprio UID.
      allow create, update: if isAuthed() && request.resource.data.userId == request.auth.uid;
      // O dono do token pode removê-lo (ex.: ao desativar notificações ou sair).
      allow delete: if isAuthed() && resource.data.userId == request.auth.uid;
    }

    // Coleção interna de rate limiting — acesso bloqueado para clientes
    // Somente Cloud Functions (Admin SDK) podem ler/escrever
    match /_rateLimits/{docId} {
      allow read, write: if false;
    }

    // Lápides de eventos apagados (function onEventDeleted); só as rules consultam.
    match /deletedEvents/{eventId} {
      allow read, write: if false;
    }

    // Interruptor do Desafio da Kombi, ligado pelo admin no painel: leitura pública
    // (a tela precisa explicar que está fechado antes mesmo do login), escrita só admin.
    match /config/desafio {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Desafio da Kombi: UM documento por mesa (id = mesa). Grupo de 5 em 3 minutos.
    // Prazo (3 min) e carência (mais 5 min até a mesa reabrir) são contados pelo
    // relógio do SERVIDOR a partir de iniciadoEm — o cliente não estica o tempo,
    // não reabre a mesa antes da hora e só consegue adicionar a si mesmo ao grupo.
    match /desafios/{mesa} {
      // O desafio só roda quando o admin liga no painel. Documento ausente ou
      // aberto != true = fechado: o padrão seguro é ninguém jogar.
      function jaAbriu() {
        return exists(/databases/$(database)/documents/config/desafio)
          && get(/databases/$(database)/documents/config/desafio).data.aberto == true;
      }
      // Quem já ganhou (carimbo gravado pela function onDesafioLiberado) não joga de novo.
      function jaGanhou() {
        return exists(/databases/$(database)/documents/desafioGanhadores/$(request.auth.uid));
      }
      function inicioValido() {
        let d = request.resource.data;
        return isAuthed()
          && jaAbriu()
          && !jaGanhou()
          && d.mesa == mesa
          && d.liderId == request.auth.uid
          && d.membros == [request.auth.uid]
          && d.iniciadoEm == request.time
          && !('liberadoEm' in d);
      }
      allow read: if isAuthed();
      allow create: if inicioValido();
      allow update: if isAuthed() && (
        // Reinício: só depois de prazo (3) + carência (5) de uma rodada que NÃO fechou 5.
        // Mesa que ganhou fica "queimada": 1 prêmio por mesa é o que limita o estoque.
        (inicioValido() && resource.data.membros.size() < 5 && request.time >= resource.data.iniciadoEm + duration.value(8, 'm')) ||
        // Entrar no grupo: dentro do prazo, com vaga, sem estar nele, adicionando só a si
        // mesmo no fim da lista; quem completa o 5º carimba liberadoEm com a hora do servidor.
        (
          jaAbriu()
          && !jaGanhou()
          && request.time < resource.data.iniciadoEm + duration.value(3, 'm')
          && resource.data.membros.size() < 5
          && !(request.auth.uid in resource.data.membros)
          && request.resource.data.membros == resource.data.membros.concat([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros', 'liberadoEm'])
          && (
            (request.resource.data.membros.size() < 5 && !('liberadoEm' in request.resource.data))
            || (request.resource.data.membros.size() == 5 && request.resource.data.liberadoEm == request.time)
          )
        ) ||
        // Entrega do refrigerante: só admin, só em mesa que ganhou, só o carimbo e uma
        // vez só — é o que impede o mesmo grupo de retirar duas vezes com a tela verde.
        (
          isAdmin()
          && resource.data.membros.size() >= 5
          && !('entregueEm' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entregueEm'])
          && request.resource.data.entregueEm == request.time
        )
      );
      allow delete: if isAdmin();
    }

    // Carimbo de "já ganhou" (1 vitória por conta): escrito SÓ pela function
    // onDesafioLiberado (Admin SDK). O próprio usuário lê o seu para ver a tela certa.
    match /desafioGanhadores/{uid} {
      allow read: if isAuthed() && request.auth.uid == uid;
      allow write: if false;
    }

  }
}
